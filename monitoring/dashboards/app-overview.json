{
  "__inputs": [
    {
      "name": "DS_LOKI",
      "label": "Loki",
      "description": "",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "loki", "name": "Loki", "version": "1.0.0" }
  ],
  "title": "App Overview - FastAPI & Celery",
  "uid": "app-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 4,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    { "type": "row", "title": "FastAPI", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "collapsed": false, "panels": [] },
    {
      "type": "timeseries",
      "title": "Request Rate (req/s)",
      "gridPos": { "h": 9, "w": 8, "x": 0, "y": 1 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "fixed", "fixedColor": "green" },
          "custom": {
            "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2,
            "fillOpacity": 25, "gradientMode": "opacity",
            "showPoints": "always", "pointSize": 5, "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max", "mean"] },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        { "expr": "sum(rate({compose_service=\"fast_backend\"} | json [$__interval]))", "refId": "A", "legendFormat": "requests/s" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Avg Response Time",
      "gridPos": { "h": 9, "w": 8, "x": 8, "y": 1 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "custom": {
            "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2,
            "fillOpacity": 25, "gradientMode": "opacity",
            "showPoints": "always", "pointSize": 5, "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max", "mean"] },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        { "expr": "avg(avg_over_time({compose_service=\"fast_backend\"} | json | unwrap duration_ms [$__interval]))", "refId": "A", "legendFormat": "avg response ms" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Error Rate (5xx/s)",
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 1 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 0.0001 } ] },
          "custom": {
            "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2,
            "fillOpacity": 25, "gradientMode": "scheme",
            "showPoints": "always", "pointSize": 5, "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max", "mean"] },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        { "expr": "sum(rate({compose_service=\"fast_backend\"} | json | status_code >= 500 [$__interval]))", "refId": "A", "legendFormat": "5xx/s" }
      ]
    },

    { "type": "row", "title": "Celery", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 10 }, "collapsed": false, "panels": [] },
    {
      "type": "timeseries",
      "title": "Task Completion Rate (tasks/s)",
      "gridPos": { "h": 9, "w": 8, "x": 0, "y": 11 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "fixed", "fixedColor": "green" },
          "custom": {
            "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2,
            "fillOpacity": 25, "gradientMode": "opacity",
            "showPoints": "always", "pointSize": 5, "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max", "mean"] },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        { "expr": "sum(rate({compose_service=~\"celery_.*\"} | json | message=\"Task finished\" [$__interval]))", "refId": "A", "legendFormat": "tasks/s" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Avg Task Duration",
      "gridPos": { "h": 9, "w": 8, "x": 8, "y": 11 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "custom": {
            "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2,
            "fillOpacity": 25, "gradientMode": "opacity",
            "showPoints": "always", "pointSize": 5, "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max", "mean"] },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        { "expr": "avg(avg_over_time({compose_service=~\"celery_.*\"} | json | message=\"Task finished\" | unwrap duration_ms [$__interval]))", "refId": "A", "legendFormat": "avg duration ms" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Task Failure Rate (failures/s)",
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 11 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 0.0001 } ] },
          "custom": {
            "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2,
            "fillOpacity": 25, "gradientMode": "scheme",
            "showPoints": "always", "pointSize": 5, "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max", "mean"] },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        { "expr": "sum(rate({compose_service=~\"celery_.*\"} | json | message=\"Task failed\" [$__interval]))", "refId": "A", "legendFormat": "failures/s" }
      ]
    },

    { "type": "row", "title": "Redis (log activity only — no metrics exporter yet)", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 20 }, "collapsed": false, "panels": [] },
    {
      "type": "timeseries",
      "title": "Log Volume (lines/s)",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 21 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "fixed", "fixedColor": "purple" },
          "custom": {
            "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2,
            "fillOpacity": 25, "gradientMode": "opacity",
            "showPoints": "always", "pointSize": 5, "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max", "mean"] },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        { "expr": "sum(rate({compose_service=\"redis\"} [$__interval]))", "refId": "A", "legendFormat": "lines/s" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Error Lines (lines/s)",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 21 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 0.0001 } ] },
          "custom": {
            "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2,
            "fillOpacity": 25, "gradientMode": "scheme",
            "showPoints": "always", "pointSize": 5, "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max", "mean"] },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        { "expr": "sum(rate({compose_service=\"redis\"} |~ \"(?i)error\" [$__interval]))", "refId": "A", "legendFormat": "errors/s" }
      ]
    },

    { "type": "row", "title": "Postgres (log activity only — no metrics exporter yet)", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 30 }, "collapsed": false, "panels": [] },
    {
      "type": "timeseries",
      "title": "Log Volume by Instance (lines/s)",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 31 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2,
            "fillOpacity": 15, "gradientMode": "opacity",
            "showPoints": "always", "pointSize": 5, "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max", "mean"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        { "expr": "sum by (compose_service) (rate({compose_service=~\"database|db_read1|db_read2\"} [$__interval]))", "refId": "A", "legendFormat": "{{compose_service}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Error/Fatal Lines by Instance (lines/s)",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 31 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2,
            "fillOpacity": 15, "gradientMode": "opacity",
            "showPoints": "always", "pointSize": 5, "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max", "mean"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        { "expr": "sum by (compose_service) (rate({compose_service=~\"database|db_read1|db_read2\"} |~ \"(?i)error|fatal|panic\" [$__interval]))", "refId": "A", "legendFormat": "{{compose_service}}" }
      ]
    },

    { "type": "row", "title": "GeoServer (log activity only — no metrics exporter yet)", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 40 }, "collapsed": false, "panels": [] },
    {
      "type": "timeseries",
      "title": "Log Volume (lines/s)",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 41 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "fixed", "fixedColor": "purple" },
          "custom": {
            "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2,
            "fillOpacity": 25, "gradientMode": "opacity",
            "showPoints": "always", "pointSize": 5, "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max", "mean"] },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        { "expr": "sum(rate({compose_service=\"geoserver\"} [$__interval]))", "refId": "A", "legendFormat": "lines/s" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Error Lines (lines/s)",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 41 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 0.0001 } ] },
          "custom": {
            "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2,
            "fillOpacity": 25, "gradientMode": "scheme",
            "showPoints": "always", "pointSize": 5, "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max", "mean"] },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        { "expr": "sum(rate({compose_service=\"geoserver\"} |~ \"(?i)error|exception\" [$__interval]))", "refId": "A", "legendFormat": "errors/s" }
      ]
    }
  ]
}
